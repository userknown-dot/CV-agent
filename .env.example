# copy to .env and fill in
LLM_PROVIDER=anthropic            # anthropic | fake (fake = offline, for tests only)
MODEL_NAME=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# REQUIRED: the secret that signs login tokens. The app refuses to start without a strong one (32+ characters).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SEED_PASSWORD=demo-pass-123
DATABASE_URL=sqlite:///./data/app.db
USAGE_JSONL_PATH=./data/raw_usage.jsonl

# cost controls (0 = unlimited)
DEFAULT_MONTHLY_TOKEN_BUDGET=500000
RATE_LIMIT_PER_MINUTE=60

# To use OpenAI instead: LLM_PROVIDER=openai, MODEL_NAME=gpt-4o-mini, OPENAI_API_KEY=...

# OpenRouter (one key, many models; some are free): LLM_PROVIDER=openrouter, OPENROUTER_API_KEY=sk-or-..., MODEL_NAME=openai/gpt-4o-mini
# Free models end in :free (check openrouter.ai/models for what is currently available) but have strict rate limits.

# Fallback chain: the next provider is tried when the previous fails for any reason (quota, bad key, outage ...). Providers with no key are skipped.
# LLM_PROVIDER=openai,anthropic,openrouter
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Sentiment confidence = share of repeated runs that agree on the label. Each feedback is analysed this many times (5x the tokens). 1 = no confidence is claimed.
# SENTIMENT_VOTES=5

# Check the role fit for the CV's own category automatically after classification (2 extra LLM calls per CV). false = only on request.
# AUTO_ROLE_FIT=true
